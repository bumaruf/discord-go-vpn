# Only MONGODB_URI is required; each variable is described in server/README.md (Variáveis de ambiente).

# host:port the clients dial. Empty: the public IP is discovered. No port is appended when set.
ENDPOINT=

# 0 stops only the generation of VPN_PANEL_SECRET.
PANEL=1


# ------------------------------------------------------------------ panel

# Required: where provisiond checks the invites that let clients in and writes metrics.
# Use an Atlas user for the server only, separate from Vercel's.
MONGODB_URI=
MONGODB_DB=vpn

# Authorizes panel actions. Empty: generated once and kept in the volume as panel-actions.token.
# Must hold the same value as on Vercel.
VPN_PANEL_SECRET=

# Signs live stream tickets. Never generated, since Vercel needs the same value:
#   openssl rand -base64 32
VPN_LIVE_SECRET=

# The panel URL, the only origin allowed by the stream's CORS.
PANEL_ORIGIN=https://panel.example.com

# Tunnel subnet, always a /24.
WG_SUBNET=10.9.0.0/24


# -------------------------------------------------- "panel" profile (caddy)
# Only for: docker compose --profile panel up -d

# Subdomain with a DNS A record for this VPS. On the panel, PROVISIOND_URL=https://<this domain>.
PANEL_DOMAIN=vpn-api.example.com
