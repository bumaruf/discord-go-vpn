# ------------------------------------------------------------------ admin
# The panel's only account (see lib/admin.ts). Never prefix these with NEXT_PUBLIC_, which would
# send them to the browser.

ADMIN_USERNAME=admin

# Generate with: npm run hash-password -- "password"
ADMIN_PASSWORD_HASH=
# Plaintext alternative, readable by anyone who can read the Worker's secrets. Prefer the hash.
ADMIN_PASSWORD=


# --------------------------------------------------------------- session
# Signs the panel session. Generate with: openssl rand -base64 32
AUTH_SECRET=
# In production, the panel's public URL.
NEXTAUTH_URL=http://localhost:3000

# Auth.js rejects untrusted hosts so a forged Host header can't redirect a login elsewhere. Only
# Vercel is detected automatically; on Cloudflare and locally, every auth route answers 500 without
# this.
AUTH_TRUST_HOST=true


# -------------------------------------------------------------- database
# Only for npm run setup and npm run merge-devices: the panel itself reads and writes through
# provisiond, and the Worker doesn't get these.
MONGODB_URI=
MONGODB_DB=vpn


# -------------------------------------------------------------- provisiond
# The VPN server, behind Caddy with a valid certificate.
PROVISIOND_URL=https://vpn-api.example.com

# Authorizes actions (disconnect, revoke). Must hold the same value as on provisiond.
VPN_PANEL_SECRET=

# Signs the short-lived live stream tickets. Must hold the same value as on provisiond.
VPN_LIVE_SECRET=

# Go into every connection token the panel generates: the address clients lease from (port 51821,
# not PROVISIOND_URL) and the certificate fingerprint provisiond logs at startup. Without both,
# creating an invite fails.
PROVISIOND_LEASE_URL=https://203.0.113.10:51821
PROVISIOND_FINGERPRINT=

# Monthly quota for the usage KPI's progress bar. Without it the KPI shows only the number.
MONTHLY_QUOTA_GB=


# --------------------------------------------------------------- display
# Sidebar and header labels, not secrets. Empty or unset, they show "wg0" and "51820/udp".
NEXT_PUBLIC_SERVER_NAME=
NEXT_PUBLIC_WG_PORT=
